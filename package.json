{
  "name": "fpl-analytics-dashboard",
  "private": true,
  "version": "1.40.0",
  "description": "Scoutline: a scouting and analytics app for Fantasy Premier League managers. Independent; not affiliated with or endorsed by the Premier League.",
  "author": "Scoutline",
  "license": "SEE LICENSE IN LICENSE.txt",
  "main": "electron/main.js",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "start": "node server/dist/index.js",
    "test": "npm run test -w server && npm run test -w client && node --test \"electron/*.test.js\"",
    "server": "npm run dev -w server",
    "client": "npm run dev -w client",
    "build:electron-server": "esbuild server/src/app.ts --bundle --platform=node --format=cjs --log-override:empty-import-meta=silent --outfile=server/dist/app.bundle.cjs",
    "legal:notices": "tsx scripts/legal/third-party-notices.ts",
    "electron:build": "npm run legal:notices && npm run build -w client && npm run build:electron-server && electron-builder",
    "electron:start": "npm run build -w client && npm run build:electron-server && electron .",
    "club-history:snapshot": "tsx scripts/club-history/snapshot-vaastav.ts",
    "club-history:backfill": "tsx scripts/club-history/backfill-vaastav.ts",
    "club-history:archive": "tsx scripts/club-history/archive-current.ts",
    "club-history:build": "tsx scripts/club-history/build-aggregates.ts",
    "understat:sync": "tsx scripts/understat/sync.ts",
    "unreleased": "tsx scripts/release/unreleased.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "png-to-ico": "^3.0.2"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "build": {
    "appId": "com.fpldashboard.app",
    "productName": "Scoutline",
    "copyright": "Copyright © 2026 Scoutline. All rights reserved.",
    "asar": false,
    "files": [
      "electron/**/*",
      "!electron/**/*.test.js",
      "server/dist/app.bundle.cjs",
      "client/dist/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE.txt"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "requiemalex",
      "repo": "fpl-analytics-dashboard",
      "releaseType": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.sports"
    },
    "icon": "build/icon.ico",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "license": "LICENSE.txt"
    },
    "linux": {
      "target": "AppImage",
      "category": "Sports"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
